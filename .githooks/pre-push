#!/bin/sh
# Git pre-push hook executing unified verification (scripts/verify.py)
# Guarantees 100% parity between local developer pushes and CI validation.

echo "=========================================="
echo "Running Pre-Push Quality Verification"
echo "=========================================="

# Ensure dev dependencies are synced
uv sync --all-groups || exit 1

# Execute the exact same verification suite as CI
uv run python scripts/verify.py --check-version
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Quality verification failed. Push aborted."
    echo "Fix the reported errors or run 'uv run python scripts/verify.py --fix' before pushing."
    exit 1
fi

echo "=========================================="
echo "✅ All verification checks passed! Proceeding with push."
echo "=========================================="
exit 0


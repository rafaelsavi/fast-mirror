{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch app",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "launch.pyw"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Workspace] Format and fix with Ruff",
            "type": "shell",
            "command": "uvx ruff check \"${input:path}\" --fix --unsafe-fixes && uvx ruff format \"${input:path}\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "path",
            "description": "Enter the path to the file or directory",
            "default": "${fileDirname}"
        }
    ]
}